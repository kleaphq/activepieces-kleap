{
  "name": "@kleap/piece-kleap",
  "version": "0.1.0",
  "description": "Activepieces piece for Kleap: build, edit and publish websites with AI, read leads, analytics and the app database, buy domains.",
  "keywords": [
    "activepieces",
    "piece",
    "kleap",
    "ai website builder",
    "automation"
  ],
  "homepage": "https://kleap.co",
  "license": "MIT",
  "author": "Kleap <hello@kleap.co>",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bundle": "node scripts/bundle.mjs",
    "test": "node --import tsx --test test/unit.test.ts",
    "test:live": "node --import tsx --test --test-timeout=1800000 test/live.test.ts",
    "metadata": "node scripts/metadata.mjs",
    "export:monorepo": "node scripts/export-to-monorepo.mjs",
    "test:live-db": "node --import tsx --test --test-timeout=600000 test/live-db.test.ts"
  },
  "dependencies": {
    "@activepieces/pieces-common": "0.12.5",
    "@activepieces/pieces-framework": "0.32.0",
    "tslib": "2.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "esbuild": "0.25.12",
    "nock": "^14.0.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
